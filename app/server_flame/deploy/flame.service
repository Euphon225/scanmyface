[Unit]
Description=FLAME matcher (ScanMyFace) — FastAPI/uvicorn
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/srv/flame/app
Environment=FLAME_DATA_DIR=/srv/flame/data
Environment=FLAME_OUT_DIR=/srv/flame/outputs
Environment=FLAME_APP_DIR=/srv/flame/app_prod
# SENTRY_DSN à renseigner depuis Doppler (optionnel ; vide = Sentry off côté serveur)
Environment=SENTRY_DSN=
ExecStart=/srv/flame/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8001 --workers 1
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
